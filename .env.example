# Copy to .env and fill in real values. Never commit the real .env file.
#
# THIS ONE FILE COVERS BOTH LOCAL TESTING AND PRODUCTION — there is only
# one settings module (egup_system.settings). Nothing below is required
# to just run the site locally; see "LOCAL TESTING" below for the
# actual minimum.

# ============================================================
# LOCAL TESTING — minimum needed to run `python manage.py runserver`
# ============================================================
# Leave DATABASE_URL unset and it uses a local SQLite file automatically.
# Leave everything else in this file blank/unset too — DEBUG defaults to
# True, ALLOWED_HOSTS defaults to localhost, cookies work over plain
# HTTP. You only need a real SECRET_KEY (any random string is fine for
# local testing) to silence Django's dev-key warning:
SECRET_KEY=change-this-to-any-random-string-for-local-testing

# Uncomment to test against a real local Postgres instead of SQLite:
# DATABASE_URL=postgres://user:password@localhost:5432/egup

# Only needed if you'll set PayHero/Daraja credentials from the admin
# dashboard (Finance > Payment Credentials) instead of the PAYHERO_*/
# MPESA_* variables below. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# ============================================================
# PRODUCTION — all of these should be set explicitly on deploy
# ============================================================
DEBUG=False
ALLOWED_HOSTS=egup.example.com,www.egup.example.com
CSRF_TRUSTED_ORIGINS=https://egup.example.com,https://www.egup.example.com
DATABASE_URL=postgres://user:password@host:5432/egup

# PayHero (PRIMARY payment provider) — server-side only, never exposed to
# frontend. Registration/renewal payment requests will fail without these
# (that's fine for browsing the site locally, but the payment flow itself
# needs real sandbox credentials to test end-to-end).
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_CHANNEL_ID=
PAYHERO_CALLBACK_BASE_URL=https://egup.example.com/payments/callback/payhero/

# Daraja (SECONDARY/fallback — not yet audited, see providers.py)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=

# Infra — set BEHIND_CLOUDFLARE=False for local testing (no Cloudflare in
# front locally, so trust REMOTE_ADDR/X-Forwarded-For instead of
# CF-Connecting-IP; see apps/monitoring/ip_utils.py)
BEHIND_CLOUDFLARE=True
ADMIN_ROUTE_PREFIX=/dashboard/

# Object storage — leave USE_S3_STORAGE unset/False for local testing
# (uses local ./media/ folder). Set True + fill in below for production.
USE_S3_STORAGE=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=

# Cache / rate limiting — added by the security hardening pass. Without
# this, rate limits (payment attempts, OTP requests, login lockouts)
# only work within a single gunicorn worker process, not shared across
# them. Most hosts offer Redis as a one-click add-on that sets this for
# you. Leave unset for local dev (falls back to in-memory automatically).
REDIS_URL=

# SMS provider for renewal OTP codes (apps/members/sms.py) — renewal now
# requires a phone-verified code before it can start a payment (a
# membership number alone used to be enough, which let anyone trigger a
# payment against a stranger's phone; fixed in the security pass). Until
# a real gateway is implemented in that file AND this is set to True,
# OTP codes are only written to server logs, not sent anywhere — fine
# for testing the flow yourself, not fine for real members.
SMS_PROVIDER_CONFIGURED=False
